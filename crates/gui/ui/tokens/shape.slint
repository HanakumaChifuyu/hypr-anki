export global Shape {
    in-out property <length> radius-none:0px;
    in-out property <length> radius-xs: 2px;
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 8px;
    in-out property <length> radius-lg: 12px;
    in-out property <length> radius-full: 9999px;

    // 导航内容宽度，加左右各 16px 内边距后侧边栏总宽为 240px。
    in-out property <length> left-side-bar-container-width:208px;
    in-out property <length> left-side-bar-item-container-height:44px;
    in-out property <length> left-side-bar-item-height:20px;
    in-out property <length> side-bar-brand-height:48px;
    in-out property <length> side-bar-brand-icon-size:32px;

    // 原生窗口按钮区域与页面顶部拖动区域共用这一高度。
    in-out property <length> window-header-height:48px;
}
