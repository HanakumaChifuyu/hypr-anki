import { Colors } from "../tokens/colors.slint";

export component BaseButtonBox inherits Rectangle {
    callback click <=> touch.clicked;
    border-radius: 6px;
    border-width: 1px;
    border-color: Colors.border-default;
    background: touch.pressed ? Colors.bg-pressed : (touch.has-hover ? Colors.bg-hover : Colors.bg-neutral);

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        alignment: center;
        @children
    }
}
