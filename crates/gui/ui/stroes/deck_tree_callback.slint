export enum DeckDropPosition { before, inside, after }

// 所有操作都是请求：业务后端处理成功后更新 AppWindow.decks。
// UI 不提前修改列表或折叠状态，也不在拖拽结束时删除源行。
// Rust 接入：app.global::<DeckTreeCallback>().on_expansion_requested(...)
// 完成展开 / 折叠后，在 UI 线程 app.set_decks(新的可见先序列表模型)。
export global DeckTreeCallback {
    callback expansion-requested(id: int, expanded: bool);
    callback collapse-all-requested();
    callback study-requested(id: int);
    callback new-root-requested();
    callback new-child-requested(parent-id: int);
    callback new-sibling-requested(sibling-id: int);
    callback import-root-requested();
    callback import-requested(id: int);
    callback rename-requested(id: int);
    callback delete-requested(id: int);
    callback move-requested(source-id: int, target-id: int, position: DeckDropPosition);

    // 原生拖拽载荷的构造 / 校验 / 解码由 Rust UI 适配层处理。
    pure callback drag-data(id: int) -> data-transfer;
    callback can-drop(data: data-transfer, target-id: int, position: DeckDropPosition) -> bool;
    callback drop-requested(data: data-transfer, target-id: int, position: DeckDropPosition);
}
